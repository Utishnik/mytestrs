---
 Cargo.toml |  2 +-
 src/lib.rs | 13 ++-----------
 2 files changed, 3 insertions(+), 12 deletions(-)

diff --git a/Cargo.toml b/Cargo.toml
index 6569b20..54d39a7 100644
--- a/Cargo.toml
+++ b/Cargo.toml
@@ -80,7 +80,7 @@ panic = "unwind"
 
 # Отдельный профиль для CPU-профилирования через pprof: debug-символы для
 # нормальных стеков во flamegraph, без strip и LTO.
-# Запуск: R3_PPROF=1 cargo run --profile profiling --features pprof
+# Запуск: cargo run --profile profiling --features pprof
 [profile.profiling]
 inherits = "release"
 debug = true
diff --git a/src/lib.rs b/src/lib.rs
index ee9e08e..6bedf3f 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -3945,17 +3945,8 @@ pub struct PprofGuard {
 impl PprofGuard {
     #[cfg_attr(coverage, coverage(off))]
     fn new() -> Self {
-        let enabled = std::env::var("R3_PPROF")
-            .map(|v| v == "1" || v.eq_ignore_ascii_case("true"))
-            .unwrap_or(false);
-
-        if !enabled {
-            return Self {
-                guard: None,
-                out: String::new(),
-            };
-        }
-
+        // Профилирование включается самой фичей `pprof`: если бинарник собран
+        // с `--features pprof`, профайлер стартует всегда (без env-переменных).
         let hz: i32 = std::env::var("R3_PPROF_HZ")
             .ok()
             .and_then(|v| v.parse::<i32>().ok())
